<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nombre del launcher en el sistema -->
    <string name="launcher_name" translatable="false">CleanGTV</string>

    <!-- Tus 5 aplicaciones fijadas en el dock -->
    <string-array name="dock_apps">
        <item>ar.com.flow.androidtv</item>
        <item>com.netflix.ninja</item>
        <item>com.stremio.one</item>
        <item>org.smarttube.stable</item>
        <item>com.google.android.youtube.tv</item>
    </string-array>

    <!-- Apps ocultas de la grilla (vacío, sin basura de Xiaomi) -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- Sin app de sintonizador Xiaomi -->
    <string name="live_tv_package" translatable="false"></string>
    <string name="live_tv_action" translatable="false"></string>
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>
    <string name="input_action" translatable="false"></string>

    <!-- Desactivar calendario persa y módulos de rezos/athkar -->
    <bool name="shamsi_date">false</bool>
    <bool name="dream_athkar">false</bool>
    <bool name="home_prayer">false</bool>
    <bool name="dream_prayer">false</bool>
    <bool name="dream_analog">false</bool>
    <integer name="prayer_method">3</integer>

    <!-- Fotos del día de Bing y reproductor Now Playing (Spotify/YouTube) activos -->
    <bool name="dream_photos">true</bool>
    <bool name="now_playing">true</bool>
    <bool name="home_photo">true</bool>

    <!-- App de VPN opcional (dejar vacío para que abra ajustes Wi-Fi) -->
    <string name="vpn_app" translatable="false"></string>

    <!-- Clima de Open-Meteo configurado para San Juan -->
    <string name="weather_latitude" translatable="false">-31.5375</string>
    <string name="weather_longitude" translatable="false">-68.5364</string>
    <string name="weather_place" translatable="false">San Juan</string>

    <!-- Diseño de grilla y 5 columnas para que entren tus 5 apps en el dock -->
    <integer name="rows_below_dock">0</integer>
    <integer name="columns">5</integer>
    <integer name="grid_columns">5</integer>

    <bool name="show_home_settings_shortcut">false</bool>
    <bool name="module_cards">true</bool>
</resources>